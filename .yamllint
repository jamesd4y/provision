---
extends: default

rules:
  line-length:
    max: 120
    allow-non-breakable-words: true
    level: warning
  comments:
    min-spaces-from-content: 1
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  # Ansible files conventionally start with ---; host and service files do not.
  # Both are fine, so do not have an opinion.
  document-start: disable
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true

ignore: |
  build/
  .venv/
  tofu/
